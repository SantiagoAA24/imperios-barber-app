# Copia este archivo a .env (nunca lo subas al repositorio).
DATABASE_URL=postgresql+psycopg://imperio:imperio@localhost:5432/imperio
# Mínimo 32 caracteres o la API no arranca. Genera uno con: openssl rand -hex 32
JWT_SECRET=cambia-esto-por-un-secreto-largo-de-32-o-mas-caracteres
ALLOWED_ORIGINS=http://localhost:5173
# Solo desarrollo local sin HTTPS; en producción deja true y ENVIRONMENT=production.
COOKIE_SECURE=false
ENVIRONMENT=development
DEFAULT_BUSINESS_SLUG=imperio
