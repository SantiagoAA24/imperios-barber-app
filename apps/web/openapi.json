  "components": {
    "schemas": {
      "AppointmentStatus": {
        "type": "string",
        "enum": [
          "booked",
          "attended",
          "no_show",
          "cancelled"
        ],
        "title": "AppointmentStatus"
      },
      "AvailabilityOut": {
        "properties": {
          "date": {
            "type": "string",
            "title": "Date"
          },
          "slots": {
            "items": {
              "$ref": "#/components/schemas/SlotOut"
            },
            "type": "array",
            "title": "Slots"
          }
        },
        "type": "object",
        "required": [
          "date",
          "slots"
        ],
        "title": "AvailabilityOut"
      },
      "BarberBrief": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          }
        },
        "type": "object",
        "required": [
          "id",
          "display_name"
        ],
        "title": "BarberBrief"
      },
      "BusinessBrief": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "BusinessBrief"
      },
      "ClientBrief": {
        "properties": {
          "first_name": {
            "type": "string",
            "title": "First Name"
          }
        },
        "type": "object",
        "required": [
          "first_name"
        ],
        "title": "ClientBrief"
      },
      "ClientIn": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "phone": {
            "type": "string",
            "title": "Phone"
          }
        },
        "type": "object",
        "required": [
          "name",
          "phone"
        ],
        "title": "ClientIn"
      },
      "CreateAppointmentIn": {
        "properties": {
          "service_id": {
            "type": "string",
            "format": "uuid",
            "title": "Service Id"
          },
          "barber_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Barber Id"
          },
          "starts_at": {
            "type": "string",
            "format": "date-time",
            "title": "Starts At"
          },
          "client": {
            "$ref": "#/components/schemas/ClientIn"
          },
          "consent": {
            "type": "boolean",
            "title": "Consent"
          },
          "website": {
            "type": "string",
            "title": "Website",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "service_id",
          "starts_at",
          "client",
          "consent"
        ],
        "title": "CreateAppointmentIn"
      },
      "CreatedAppointment": {
        "properties": {
          "appointment": {
            "$ref": "#/components/schemas/PublicAppointment"
          },
          "manage_token": {
            "type": "string",
            "title": "Manage Token"
          },
          "manage_path": {
            "type": "string",
            "title": "Manage Path"
          }
        },
        "type": "object",
        "required": [
          "appointment",
          "manage_token",
          "manage_path"
        ],
        "title": "CreatedAppointment"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "additionalProperties": true,
            "type": "object",
            "title": "Details",
            "default": {}
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 3,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
